{
  "manifest_version": 2,
  "id": "orb_nimbus",
  "name": "Orb · Nimbus",
  "description": "Light diffusing through a cloud: a true volumetric march with Beer-Lambert transmittance, a second march toward the light for self-shadowing, and a Henyey-Greenstein phase function that blooms the lit limb (WebGL). Ported from Orbkit shdr-21 (MIT).",
  "api_version": 1,
  "overlay_width": 160,
  "overlay_height": 160,
  "entry": "theme.js",
  "credit": "Orbkit `shdr-21` (MIT) — https://github.com/zzzzshawn/orbkit",
  "params": {
    "speed": 10.0,
    "camDist": 4.4,
    "focal": 1.8,
    "radius": 2.0,
    "scale": 0.8,
    "churn": 0.3,
    "threshold": 0.075,
    "edgeSoft": 0.8,
    "density": 3.2,
    "absorb": 1.4,
    "shadowAbsorb": 2.4,
    "shadowLift": 0.55,
    "aniso": 0.45,
    "lightSpin": 0.12,
    "power": 1.9,
    "ambient": 0.12,
    "exposure": 1.0,
    "alphaGain": 1.5,
    "colors": {
      "light": "#ffd7a3",
      "shadow": "#3a4a8c"
    }
  }
}
